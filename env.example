# =========================
# 配置说明
# =========================
# 所有部署配置都由环境变量或 Secret 提供。“系统设置”页只读展示当前生效值。
# 修改配置后需要重启后端；runtime 数据库不保存配置覆盖。

# =========================
# 应用基础配置
# =========================
# 应用名称，只影响文档和接口展示。
APP_NAME="Text2SQL Backend"
# 应用版本号。
APP_VERSION="0.3.0"
# 运行环境标识，常见值如 dev / test / prod。
APP_ENV="dev"
# 日志级别，常见值：DEBUG / INFO / WARNING / ERROR。
LOG_LEVEL="INFO"
# 是否开启 FastAPI 的 docs / redoc / openapi。
ENABLE_DOCS="true"
# =========================
# 业务数据库
# =========================
# 主业务库连接串。
BUSINESS_DATABASE_URL="oracle+oracledb://admin:admin123@127.0.0.1:1521/?service_name=FREEPDB1"
# Docker Compose 内后端使用的业务库连接串；不设置时连接 Compose 内置 Oracle。
# DOCKER_BUSINESS_DATABASE_URL="oracle+oracledb://readonly:password@oracle.example.internal:1521/?service_name=BUSINESS"
# 限定允许同步的 schema，多个值用逗号分隔。Compose 优先读取 DOCKER_BUSINESS_DATABASE_SCHEMAS。
BUSINESS_DATABASE_SCHEMAS=""
# DOCKER_BUSINESS_DATABASE_SCHEMAS="APP,REPORT"

# =========================
# Runtime 数据库
# =========================
# runtime 库用于保存会话、trace、query log、SQL audit、feedback 等运行时数据。
# 单实例 runtime 库使用 SQLite；后端会自动创建目录、数据库和表，并启用 WAL。
RUNTIME_DATABASE_URL="sqlite:///./runtime/runtime.db"
# Compose 默认固定使用 /app/data/runtime.db；只有明确替换容器内路径时才设置。
# DOCKER_RUNTIME_DATABASE_URL="sqlite:////app/data/runtime.db"
# 向量 embedding 是可重建缓存，保存在数据库之外。
VECTOR_CACHE_DIR="./runtime/vector-cache"
# Compose 默认固定使用 runtime-data 卷中的 /app/data/vector-cache。
# DOCKER_VECTOR_CACHE_DIR="/app/data/vector-cache"

# =========================
# 主 LLM 配置
# =========================
# 主推理模型 API Key。
OPENAI_API_KEY="your_llm_api_key"
# 主推理模型 API Base。
OPENAI_API_BASE="https://api.siliconflow.cn/v1"
# 主推理模型名称。
LLM_MODEL="Qwen/Qwen3-14B"
# 是否启用 Qwen3 的思考模式。关闭可显著降低 Text2SQL 首字延迟。
LLM_ENABLE_THINKING="false"
# 单次 LLM 请求超时秒数。
LLM_TIMEOUT_SECONDS="120"
# LLM 调用失败后的最大重试次数。
LLM_MAX_RETRIES="2"
# SQL validator 或 execution 失败后，允许 LLM repair 的最大次数。
SQL_REPAIR_MAX_RETRIES="1"
# llama.cpp OpenAI-compatible 服务端 prompt KV cache 复用开关；留空则不透传该私有参数。
# LLM_CACHE_PROMPT="false"

# =========================
# 向量检索配置
# =========================
# 是否启用向量检索。
ENABLE_VECTOR_RETRIEVAL="true"
# 是否在语义版本发布时预热该版本的向量索引。
PREWARM_VECTOR_RETRIEVAL="true"
# 可选值通常包括：siliconflow / openai / compatible / local / disabled
VECTOR_RETRIEVAL_PROVIDER="siliconflow"
# 向量服务 API Key；默认开启向量检索时必须设置为真实值。
# Docker Compose 中该变量未设置或为空时会传入 OPENAI_API_KEY；本机直接启动后端不会隐式复用。
VECTOR_API_KEY="your_vector_api_key"
# 向量服务 API Base；不设置时由 provider 决定，siliconflow 默认 https://api.siliconflow.cn/v1。
VECTOR_API_BASE="https://api.siliconflow.cn/v1"
# 向量模型名称。
VECTOR_MODEL="Qwen/Qwen3-Embedding-8B"
# 向量维度。要和所选 embedding 模型输出保持一致。
VECTOR_DIMENSIONS="1024"
# 向量召回 top_k。多表问题需要给 example / knowledge / table_schema / join_pattern 留出覆盖空间。
VECTOR_TOP_K="8"
# 向量请求超时秒数。
VECTOR_TIMEOUT_SECONDS="20"

# =========================
# SQL / 执行治理
# =========================
# 数据库会话级 SQL 超时秒数。
SQL_TIMEOUT_SECONDS="30"
# 默认业务 SQL 结果行数限制。Oracle 使用 FETCH FIRST n ROWS ONLY。
DEFAULT_SQL_LIMIT="200"
# 高风险场景允许的最大结果行数限制。
HIGH_RISK_SQL_LIMIT="1000"
# 单次返回结果的最大行数，超过会被截断。
EXECUTION_MAX_ROWS="500"
# 慢查询阈值，单位毫秒。
SLOW_QUERY_THRESHOLD_MS="3000"

# =========================
# 执行结果缓存
# =========================
# 相同 SQL 的执行结果缓存 TTL，单位秒。
EXECUTION_CACHE_TTL_SECONDS="30"
# 执行缓存最多保留多少条。
EXECUTION_CACHE_MAX_ENTRIES="256"

# =========================
# 鉴权配置
# =========================
# JWT / token 签名密钥，生产环境必须替换。
AUTH_TOKEN_SECRET="change-me"
# 登录 token 过期时间，单位秒。默认 28800 = 8 小时。
AUTH_TOKEN_TTL_SECONDS="28800"
