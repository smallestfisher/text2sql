{
  "$defs": {
    "ContextSummary": {
      "properties": {
        "question_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Question Type"
        },
        "subject_domain": {
          "default": "unknown",
          "title": "Subject Domain",
          "type": "string"
        },
        "semantic_brief": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Semantic Brief"
        },
        "tables": {
          "items": {
            "type": "string"
          },
          "title": "Tables",
          "type": "array"
        },
        "retrieval_domains": {
          "items": {
            "type": "string"
          },
          "title": "Retrieval Domains",
          "type": "array"
        },
        "retrieval_metrics": {
          "items": {
            "type": "string"
          },
          "title": "Retrieval Metrics",
          "type": "array"
        },
        "limit": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit"
        },
        "need_clarification": {
          "default": false,
          "title": "Need Clarification",
          "type": "boolean"
        },
        "clarification_question": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clarification Question"
        },
        "source": {
          "default": "retrieval_evidence",
          "title": "Source",
          "type": "string"
        }
      },
      "title": "ContextSummary",
      "type": "object"
    },
    "FilterItem": {
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "op": {
          "enum": [
            "=",
            "!=",
            ">",
            ">=",
            "<",
            "<=",
            "between",
            "in",
            "like",
            "latest_n",
            "is_null",
            "not_null"
          ],
          "title": "Op",
          "type": "string"
        },
        "value": {
          "title": "Value"
        }
      },
      "required": [
        "field",
        "op",
        "value"
      ],
      "title": "FilterItem",
      "type": "object"
    },
    "PendingClarification": {
      "properties": {
        "original_question": {
          "title": "Original Question",
          "type": "string"
        },
        "clarification_question": {
          "title": "Clarification Question",
          "type": "string"
        },
        "effective_question": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective Question"
        },
        "semantic_brief": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Semantic Brief"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "original_question",
        "clarification_question"
      ],
      "title": "PendingClarification",
      "type": "object"
    },
    "QueryTurnRecord": {
      "properties": {
        "question": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Question"
        },
        "effective_question": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective Question"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        },
        "semantic_brief": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Semantic Brief"
        }
      },
      "title": "QueryTurnRecord",
      "type": "object"
    },
    "SortItem": {
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "order": {
          "enum": [
            "asc",
            "desc"
          ],
          "title": "Order",
          "type": "string"
        }
      },
      "required": [
        "field",
        "order"
      ],
      "title": "SortItem",
      "type": "object"
    },
    "TimeContext": {
      "properties": {
        "grain": {
          "default": "unknown",
          "enum": [
            "day",
            "week",
            "month",
            "version",
            "unknown"
          ],
          "title": "Grain",
          "type": "string"
        },
        "range": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "TimeContext",
      "type": "object"
    },
    "TimeRange": {
      "properties": {
        "start": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        },
        "end": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        }
      },
      "title": "TimeRange",
      "type": "object"
    },
    "VersionContext": {
      "properties": {
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "title": "VersionContext",
      "type": "object"
    }
  },
  "properties": {
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "topic": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Topic"
    },
    "conversation_summary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Conversation Summary"
    },
    "subject_domain": {
      "default": "unknown",
      "enum": [
        "inventory",
        "demand",
        "plan_actual",
        "sales_financial",
        "dimension",
        "unknown"
      ],
      "title": "Subject Domain",
      "type": "string"
    },
    "entities": {
      "items": {
        "type": "string"
      },
      "title": "Entities",
      "type": "array"
    },
    "tables": {
      "items": {
        "type": "string"
      },
      "title": "Tables",
      "type": "array"
    },
    "metrics": {
      "items": {
        "type": "string"
      },
      "title": "Metrics",
      "type": "array"
    },
    "dimensions": {
      "items": {
        "type": "string"
      },
      "title": "Dimensions",
      "type": "array"
    },
    "filters": {
      "items": {
        "$ref": "#/$defs/FilterItem"
      },
      "title": "Filters",
      "type": "array"
    },
    "sort": {
      "items": {
        "$ref": "#/$defs/SortItem"
      },
      "title": "Sort",
      "type": "array"
    },
    "limit": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Limit"
    },
    "time_context": {
      "anyOf": [
        {
          "$ref": "#/$defs/TimeContext"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "version_context": {
      "anyOf": [
        {
          "$ref": "#/$defs/VersionContext"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "analysis_mode": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Analysis Mode"
    },
    "last_question_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Question Type"
    },
    "last_context_summary": {
      "anyOf": [
        {
          "$ref": "#/$defs/ContextSummary"
        },
        {
          "type": "null"
        }
      ],
