    "last_result_shape": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Result Shape"
    },
    "last_semantic_brief": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Semantic Brief"
    },
    "last_effective_question": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Effective Question"
    },
    "recent_turns": {
      "items": {
        "$ref": "#/$defs/QueryTurnRecord"
      },
      "title": "Recent Turns",
      "type": "array"
    },
    "pending_clarification": {
      "anyOf": [
        {
          "$ref": "#/$defs/PendingClarification"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "session_id"
  ],
  "title": "SessionState",
  "type": "object"
}
